APP_NAME=RepoMart
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

SEO_SITE_NAME=Talipapa
SEO_DEFAULT_DESCRIPTION="Shop fresh groceries and everyday essentials from trusted local talipapa stores. Browse products, order online, and track delivery to your door across the Philippines."
SEO_OG_IMAGE=img/market.png
SEO_ICON=img/market.png
SEO_LOCALE=en_PH
# SEO_TWITTER_HANDLE=@talipapa

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=repomart
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@repomart.test"
MAIL_FROM_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@repomart.test

REPOMART_DELIVERY_FEE=50
REPOMART_NEARBY_RADIUS_KM=10

MARKETPLACE_CONTACT_EMAIL=hello@talipapa.test
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_TIKTOK_URL=
SOCIAL_X_URL=
SOCIAL_YOUTUBE_URL=

VITE_APP_NAME="${APP_NAME}"

PSGC_API_URL=https://psgc.gitlab.io/api
PSGC_CACHE_TTL=86400

OPENAI_API_KEY=
VOICE_ASSISTANT_ENABLED=false
VOICE_SEARCH_ENABLED=true
VOICE_ASSISTANT_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
VOICE_ASSISTANT_TRANSCRIBE_FALLBACK=whisper-1
VOICE_ASSISTANT_NLP_MODEL=gpt-4o-mini
VOICE_ASSISTANT_REPLY_MAX_TOKENS=120
VOICE_ASSISTANT_CACHE_TTL=3600
